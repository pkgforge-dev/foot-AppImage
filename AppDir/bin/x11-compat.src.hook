#!/bin/sh

_rundir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

_start_12to11() {
	if [ -n "$WAYLAND_DISPLAY" ]; then
		return 0
	fi

	case "$XDG_SESSION_TYPE" in
		# abort if XDG_SESSION_TYPE=wayland even when WAYLAND_DISPLAY
		# was not set, that means this system is likely broken
		# so do not bother trying to fix it lol
		wayland|WAYLAND|Wayland) return 0;;
	esac

	if pgrep -x 12to11 1>/dev/null; then
		for s in "$_rundir"/wayland-*; do
			[ -S "$s" ] || continue
			export WAYLAND_DISPLAY=${s##*/}
			break
		done
	elif [ -z "$WAYLAND_DISPLAY" ] && [ -n "$DISPLAY" ]; then
		rm -f "$_rundir"/wayland-*
		12to11 &
		# wait for the socket to be created
		n=0
		while :; do
			for s in "$_rundir"/wayland-*; do
				[ -S "$s" ] || continue
				export WAYLAND_DISPLAY="${s##*/}"
				break
			done
			if [ -n "$WAYLAND_DISPLAY" ]; then
				break
			elif [ "$n" -ge 10 ]; then
				>&2 echo "WARNING: 12to11 did not seem to have launched"
				return 0
			fi
			n=$((n + 1))
			sleep 0.1
		done
	fi
}

_start_12to11
